# ============================================================
# IntelliTamed — Configuration du serveur
# Copiez ce fichier en `.env` puis renseignez vos valeurs.
#   cp .env.example .env
# ============================================================

# Clé API Gemini (obligatoire pour le mode connecté).
# Obtenez-la gratuitement sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle Gemini (optionnel, défaut : gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Port du serveur (optionnel, défaut : 3000)
# PORT=3000
