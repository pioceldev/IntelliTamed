# ============================================================
# IntelliTamed — Backend Django (copier en .env)
#   cp .env.example .env
# ============================================================

# Clé secrète Django (générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=

# True en dev uniquement
DEBUG=True

# Base de données (moteurs supportés : sqlite, postgres, mysql)
#   SQLite  (défaut, aucun service requis) :
#     DATABASE_URL=sqlite:///db.sqlite3
#   MySQL / MariaDB + phpMyAdmin (WAMP/XAMPP) :
#     DATABASE_URL=mysql://root:@localhost:3306/intellitamed
#   PostgreSQL :
#     DATABASE_URL=postgres://user:password@localhost:5432/intellitamed
DATABASE_URL=sqlite:///db.sqlite3

# Clé API Gemini (https://aistudio.google.com/apikey) — jamais dans le frontend
GEMINI_API_KEY=

# Modèle Gemini (optionnel)
# GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------
# OAuth — Connexion / inscription via Google et GitHub
# ------------------------------------------------------------
# Google : https://console.cloud.google.com/apis/credentials
#   (OAuth client → Web → Redirect URI : http://127.0.0.1:8000/api/auth/social/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub : https://github.com/settings/developers → New OAuth App
#   (Authorization callback URL : http://127.0.0.1:8000/api/auth/social/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# URL du frontend pour le retour OAuth (vide = même origine que l'API)
# FRONTEND_BASE=http://127.0.0.1:8000

# ------------------------------------------------------------
# Brevo — emails transactionnels (bienvenue, reset mot de passe)
# ------------------------------------------------------------
# Clé API : https://app.brevo.com/settings/keys/api
# Expéditeur vérifié dans Brevo (sinon défaut : no-reply@intellitamed.com)
BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@votredomaine.com
# BREVO_SENDER_NAME=IntelliTamed
