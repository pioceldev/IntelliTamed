# ============================================================
# IntelliTamed — Backend Django (copier en .env)
#   cp .env.example .env
# ============================================================

# Clé secrète Django (générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=

# True en dev uniquement
DEBUG=True

# Base de données (moteurs supportés : sqlite, postgres, mysql)
#   SQLite  (défaut, aucun service requis) :
#     DATABASE_URL=sqlite:///db.sqlite3
#   MySQL / MariaDB + phpMyAdmin (WAMP/XAMPP) :
#     DATABASE_URL=mysql://root:@localhost:3306/intellitamed
#   PostgreSQL :
#     DATABASE_URL=postgres://user:password@localhost:5432/intellitamed
DATABASE_URL=sqlite:///db.sqlite3

# Clé API Gemini (https://aistudio.google.com/apikey) — jamais dans le frontend
GEMINI_API_KEY=

# Modèle Gemini (optionnel)
# GEMINI_MODEL=gemini-3.6-flash
